{
  "env": {
    "node": true,
    "es2021": true,
    "jest": true
  },
  "extends": ["eslint:recommended", "plugin:jest/recommended"],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "plugins": ["jest"],
  "overrides": [
    {
      "files": ["*.test.js"],
      "env": {
        "jest": true
      }
    }
  ],
  "rules": {
    "no-console": "warn",
    "consistent-return": "warn",
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
    "no-param-reassign": "warn",
    "jest/no-disabled-tests": "warn",
    "jest/no-focused-tests": "error"
  }
}
